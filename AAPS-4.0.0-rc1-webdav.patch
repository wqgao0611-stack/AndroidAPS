+/**
+ * Collects the WebDAV server address and credentials. This replaces the browser sign-in the
+ * Drive provider needs: a self-hosted server has no OAuth, just three fields.
+ *
+ * Everything the user typed last time comes back prefilled - address, username and password - so
+ * a second visit is "check and confirm" rather than "type it all again". The password starts
+ * masked and the eye button reveals it, which is the only way to spot a typo in a long password
+ * on a phone keyboard. A failed connection keeps the dialog open with the values intact.
+ */
+@Composable
+private fun WebDavConfigDialog(
+    savedUrl: String,
+    savedUsername: String,
+    savedPassword: String,
+    failed: Boolean,
+    connecting: Boolean,
+    onSave: (url: String, username: String, password: String) -> Unit,
+    onDismiss: () -> Unit
+) {
+    var url by remember { mutableStateOf(savedUrl) }
+    var username by remember { mutableStateOf(savedUsername) }
+    var password by remember { mutableStateOf(savedPassword) }
+    var passwordVisible by remember { mutableStateOf(false) }
+    val valid = url.isNotBlank() && username.isNotBlank() && password.isNotBlank() && !connecting
+
+    AlertDialog(
+        onDismissRequest = { if (!connecting) onDismiss() },
+        title = {
+            Text(
+                text = stringResource(CoreUiStrings.webdav_config_title),
+                style = MaterialTheme.typography.titleLarge
+            )
+        },
+        text = {
+            Column {
+                OutlinedTextField(
+                    value = url,
+                    onValueChange = { url = it },
+                    label = { Text(stringResource(CoreUiStrings.webdav_url_hint)) },
+                    singleLine = true,
+                    modifier = Modifier.fillMaxWidth()
+                )
+                Spacer(modifier = Modifier.height(8.dp))
+                OutlinedTextField(
+                    value = username,
+                    onValueChange = { username = it },
+                    label = { Text(stringResource(CoreUiStrings.webdav_username_hint)) },
+                    singleLine = true,
+                    modifier = Modifier.fillMaxWidth()
+                )
+                Spacer(modifier = Modifier.height(8.dp))
+                OutlinedTextField(
+                    value = password,
+                    onValueChange = { password = it },
+                    label = { Text(stringResource(CoreUiStrings.webdav_password_hint)) },
+                    singleLine = true,
+                    visualTransformation = if (passwordVisible) VisualTransformation.None else PasswordVisualTransformation(),
+                    trailingIcon = {
+                        IconButton(onClick = { passwordVisible = !passwordVisible }) {
+                            Icon(
+                                imageVector = if (passwordVisible) IcVisibilityOff else IcVisibility,
+                                contentDescription = stringResource(
+                                    if (passwordVisible) CoreUiStrings.webdav_hide_password
+                                    else CoreUiStrings.webdav_show_password
+                                )
+                            )
+                        }
+                    },
+                    modifier = Modifier.fillMaxWidth()
+                )
+                if (failed) {
+                    Spacer(modifier = Modifier.height(8.dp))
+                    Text(
+                        text = stringResource(CoreUiStrings.webdav_connect_failed),
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.error
+                    )
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(
+                enabled = valid,
+                onClick = { onSave(url.trim(), username.trim(), password) }
+            ) {
+                Text(
+                    stringResource(
+                        if (connecting) CoreUiStrings.webdav_connecting else CoreUiStrings.webdav_connect
+                    )
+                )
+            }
+        },
+        dismissButton = {
+            TextButton(enabled = !connecting, onClick = onDismiss) {
+                Text(stringResource(CoreUiStrings.cancel))
+            }
+        }
+    )
+}
