+package app.aaps.plugins.automation.actions
+
+import android.widget.LinearLayout
+import androidx.annotation.DrawableRes
+import app.aaps.core.interfaces.logging.LTag
+import app.aaps.core.interfaces.queue.Callback
+import app.aaps.core.keys.BooleanKey
+import app.aaps.core.keys.IntKey
+import app.aaps.core.keys.Preferences
+import app.aaps.core.utils.JsonHelper.safeGetDouble
+import app.aaps.plugins.automation.R
+import app.aaps.plugins.automation.elements.InputDouble
+import app.aaps.plugins.automation.elements.LabelWithElement
+import app.aaps.plugins.automation.elements.LayoutBuilder
+import dagger.android.HasAndroidInjector
+import org.json.JSONObject
+import java.text.DecimalFormat
+import javax.inject.Inject
+
+/**
+ * Sets "Max minutes of basal to limit SMB to" (preference key `smbmaxminutes`),
+ * i.e. the SMB size limit, from automation.
+ *
+ * The APS plugin reads this preference on every loop cycle
+ * (see OpenAPSSMBPlugin.invoke() -> maxSMBBasalMinutes), so the new value
+ * takes effect on the next loop run without restarting AAPS.
+ *
+ * Note: the key is flagged `defaultedBySM`. In Simple Mode the preference
+ * getter returns the default and ignores the stored value, so this action
+ * has no effect while Simple Mode is enabled.
+ *
+ * This action NEVER touches the "Enable SMB" switch (`use_smb`), which stays
+ * in its original place in the APS preferences. It only sets the minutes
+ * value; while the switch is off the setting has no effect on dosing.
+ */
+class ActionSetSmbMinutes(injector: HasAndroidInjector) : Action(injector) {
+
+    @Inject lateinit var preferences: Preferences
+
+    private val key = IntKey.ApsMaxMinutesOfBasalToLimitSmb
+
+    var minutes = InputDouble(
+        key.defaultValue.toDouble(),
+        key.min.toDouble(),
+        key.max.toDouble(),
+        5.0,
+        DecimalFormat("0")
+    )
+
+    override fun friendlyName(): Int = R.string.smbsetminuteslabel
+
+    override fun shortDescription(): String =
+        rh.gs(R.string.smbsetminutesdesc, minutes.value.toInt())
+
+    @DrawableRes override fun icon(): Int = app.aaps.core.objects.R.drawable.ic_bolus
+
+    override fun doAction(callback: Callback) {
+        val newValue = minutes.value.toInt().coerceIn(key.min, key.max)
+        val oldValue = preferences.get(key)
+        preferences.put(key, newValue)
+        if (preferences.simpleMode && key.defaultedBySM) {
+            // write happened, but PreferencesImpl.get() will keep returning the default
+            aapsLogger.warn(
+                LTag.AUTOMATION,
+                "Set '${key.key}' to $newValue, but Simple Mode is active: this key is defaulted by Simple Mode, " +
+                    "the APS loop will keep using ${key.defaultValue}. Disable Simple Mode or set it in the APS preferences."
+            )
+        } else {
+            aapsLogger.debug(LTag.AUTOMATION, "Changed '${key.key}' from $oldValue to $newValue")
+        }
+        // informational only: the enable switch is NOT modified by this action
+        if (!preferences.get(BooleanKey.ApsUseSmb)) {
+            aapsLogger.warn(
+                LTag.AUTOMATION,
+                "SMB is disabled ('use_smb' is off): the new '${key.key}' value is stored, " +
+                    "but it will have no effect until SMB is enabled in the APS preferences."
+            )
+        }
+        callback.result(instantiator.providePumpEnactResult().success(true).comment(app.aaps.core.ui.R.string.ok)).run()
+    }
+
+    override fun isValid(): Boolean =
+        minutes.value >= key.min && minutes.value <= key.max
+
+    override fun hasDialog(): Boolean = true
+
+    override fun generateDialog(root: LinearLayout) {
+        LayoutBuilder()
+            .add(
+                LabelWithElement(
+                    rh,
+                    rh.gs(R.string.smbsetminuteslabel) + ": ",
+                    rh.gs(app.aaps.core.interfaces.R.string.unit_minutes),
+                    minutes
+                )
+            )
+            .build(root)
+    }
+
+    override fun toJSON(): String {
+        val data = JSONObject()
+            .put("minutes", minutes.value)
+        return JSONObject()
+            .put("type", this.javaClass.simpleName)
+            .put("data", data)
+            .toString()
+    }
+
+    override fun fromJSON(data: String): Action {
+        val o = JSONObject(data)
+        minutes.value = safeGetDouble(o, "minutes")
+        return this
+    }
+}
