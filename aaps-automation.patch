+package app.aaps.plugins.automation.triggers
+
+import app.aaps.core.data.model.CA
+import app.aaps.plugins.automation.elements.Comparator
+import com.google.common.truth.Truth.assertThat
+import org.json.JSONException
+import org.json.JSONObject
+import org.junit.jupiter.api.Test
+import org.mockito.Mockito.`when`
+import org.skyscreamer.jsonassert.JSONAssert
+
+class TriggerCarbsAgoTest : TriggerTestBase() {
+
+    @Test
+    fun shouldRunTest() {
+        // Set last carbs time to now
+        `when`(persistenceLayer.getNewestCarbs()).thenReturn(
+            CA(
+                timestamp = now,
+                amount = 0.0,
+                duration = 0
+            )
+        )
+        `when`(dateUtil.now()).thenReturn(now + 10 * 60 * 1000) // set current time to now + 10 min
+        var t = TriggerCarbsAgo(injector).setValue(110).comparator(Comparator.Compare.IS_EQUAL)
+        assertThat(t.minutesAgo.value).isEqualTo(110)
+        assertThat(t.comparator.value).isEqualTo(Comparator.Compare.IS_EQUAL)
+        assertThat(t.shouldRun()).isFalse()
+        t = TriggerCarbsAgo(injector).setValue(10).comparator(Comparator.Compare.IS_EQUAL)
+        assertThat(t.minutesAgo.value).isEqualTo(10)
+        assertThat(t.shouldRun()).isTrue()
+        t = TriggerCarbsAgo(injector).setValue(5).comparator(Comparator.Compare.IS_EQUAL_OR_GREATER)
+        assertThat(t.shouldRun()).isTrue()
+        t = TriggerCarbsAgo(injector).setValue(310).comparator(Comparator.Compare.IS_EQUAL_OR_LESSER)
+        assertThat(t.shouldRun()).isTrue()
+        t = TriggerCarbsAgo(injector).setValue(420).comparator(Comparator.Compare.IS_EQUAL)
+        assertThat(t.shouldRun()).isFalse()
+        t = TriggerCarbsAgo(injector).setValue(390).comparator(Comparator.Compare.IS_EQUAL_OR_LESSER)
+        assertThat(t.shouldRun()).isTrue()
+        t = TriggerCarbsAgo(injector).setValue(390).comparator(Comparator.Compare.IS_EQUAL_OR_GREATER)
+        assertThat(t.shouldRun()).isFalse()
+        t = TriggerCarbsAgo(injector).setValue(2).comparator(Comparator.Compare.IS_EQUAL_OR_GREATER)
+        assertThat(t.shouldRun()).isTrue()
+        t = TriggerCarbsAgo(injector).setValue(390).comparator(Comparator.Compare.IS_EQUAL_OR_LESSER)
+        assertThat(t.shouldRun()).isTrue()
+        // Set last carbs time to 0
+        `when`(persistenceLayer.getNewestCarbs()).thenReturn(
+            CA(
+                timestamp = 0,
+                amount = 0.0,
+                duration = 0
+            )
+        )
+        t = TriggerCarbsAgo(injector).comparator(Comparator.Compare.IS_NOT_AVAILABLE)
+        assertThat(t.shouldRun()).isTrue()
+    }
+
+    @Test
+    fun shouldRunWithoutCarbsTest() {
+        // No carbs recorded at all
+        `when`(persistenceLayer.getNewestCarbs()).thenReturn(null)
+        var t = TriggerCarbsAgo(injector).setValue(10).comparator(Comparator.Compare.IS_EQUAL)
+        assertThat(t.shouldRun()).isFalse()
+        t = TriggerCarbsAgo(injector).comparator(Comparator.Compare.IS_NOT_AVAILABLE)
+        assertThat(t.shouldRun()).isTrue()
+    }
+
+    @Test fun copyConstructorTest() {
+        val t: TriggerCarbsAgo = TriggerCarbsAgo(injector).setValue(213).comparator(Comparator.Compare.IS_EQUAL_OR_LESSER)
+        val t1 = t.duplicate() as TriggerCarbsAgo
+        assertThat(t1.minutesAgo.value).isEqualTo(213)
+        assertThat(t.comparator.value).isEqualTo(Comparator.Compare.IS_EQUAL_OR_LESSER)
+    }
+
+    private var lcJson = "{\"data\":{\"comparator\":\"IS_EQUAL\",\"minutesAgo\":410},\"type\":\"TriggerCarbsAgo\"}"
+    @Test fun toJSONTest() {
+        val t: TriggerCarbsAgo = TriggerCarbsAgo(injector).setValue(410).comparator(Comparator.Compare.IS_EQUAL)
+        JSONAssert.assertEquals(lcJson, t.toJSON(), true)
+    }
+
+    @Test @Throws(JSONException::class) fun fromJSONTest() {
+        val t: TriggerCarbsAgo = TriggerCarbsAgo(injector).setValue(410).comparator(Comparator.Compare.IS_EQUAL)
+        val t2 = TriggerDummy(injector).instantiate(JSONObject(t.toJSON())) as TriggerCarbsAgo
+        assertThat(t2.comparator.value).isEqualTo(Comparator.Compare.IS_EQUAL)
+        assertThat(t2.minutesAgo.value).isEqualTo(410)
+    }
+
+    @Test fun iconTest() {
+        assertThat(TriggerCarbsAgo(injector).icon().get()).isEqualTo(app.aaps.core.objects.R.drawable.ic_cp_bolus_carbs)
+    }
+}
