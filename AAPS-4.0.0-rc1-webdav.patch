+package app.aaps.implementation.maintenance.cloud
+
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.SolidColor
+import androidx.compose.ui.graphics.vector.ImageVector
+import androidx.compose.ui.graphics.vector.path
+import androidx.compose.ui.unit.dp
+import app.aaps.core.interfaces.logging.AAPSLogger
+import app.aaps.core.interfaces.logging.LTag
+import app.aaps.core.interfaces.maintenance.CloudDirectoryManager
+import app.aaps.core.interfaces.maintenance.CloudFile
+import app.aaps.core.interfaces.maintenance.CloudFileListResult
+import app.aaps.core.interfaces.maintenance.CloudFolder
+import app.aaps.core.interfaces.maintenance.CloudStorageProvider
+import app.aaps.core.interfaces.notifications.NotificationId
+import app.aaps.core.interfaces.notifications.NotificationManager
+import app.aaps.core.interfaces.sharedPreferences.KeyValueStore
+import app.aaps.core.keys.interfaces.TextRef
+import app.aaps.implementation.ImplementationStrings
+import io.ktor.client.HttpClient
+import io.ktor.client.request.header
+import io.ktor.client.request.request
+import io.ktor.client.request.setBody
+import io.ktor.client.statement.HttpResponse
+import io.ktor.client.statement.bodyAsBytes
+import io.ktor.client.statement.bodyAsText
+import io.ktor.http.HttpHeaders
+import io.ktor.http.HttpMethod
+import io.ktor.http.decodeURLPart
+import io.ktor.http.encodeURLParameter
+import kotlin.io.encoding.Base64
+import kotlin.io.encoding.ExperimentalEncodingApi
+
+/**
+ * A self-hosted WebDAV server (e.g. hacdias/webdav, Nextcloud, Synology) as a place to keep
+ * settings exports, written to work on every platform.
+ *
+ * The shape follows [GoogleDriveProvider]: one class doing the ordering, small helpers doing the
+ * work. There is no OAuth here - the user types a server address, a username and a password once,
+ * they are stored in shared preferences and every request carries Basic auth. That is the whole
+ * sign in, which is why [startAuth] returns null and the maintenance screen opens a config dialog
+ * instead of a browser.
+ *
+ * Paths, not file IDs. Drive hands out opaque IDs; WebDAV is a filesystem, so "folder ID" means a
+ * server path like `/AAPS/export/preferences`, and "file ID" means the path of the file itself.
+ * [CloudConstants.CLOUD_PATH_SETTINGS] and friends work unchanged, because they are already paths.
+ *
+ * The PROPFIND answer is parsed with regexes rather than an XML parser, because `commonMain` has
+ * no DOM on every platform. The multistatus block is small and machine-written, so a lenient
+ * regex over `<D:response>` blocks picking out `<D:href>` and `<D:resourcetype>` is enough for
+ * the listing this provider actually needs.
+ */
+@OptIn(ExperimentalEncodingApi::class)
+class WebDavProvider(
+    private val aapsLogger: AAPSLogger,
+    private val store: KeyValueStore,
+    private val http: HttpClient,
+    private val notificationManager: NotificationManager
+) : CloudStorageProvider {
+
+    override val storageType: String = StorageTypes.WEBDAV
+    override val displayName: String = "WebDAV"
+    override val icon: ImageVector = IcWebDav
+    override val authorizedText: TextRef = ImplementationStrings.webdav_authorized
+    override val reAuthRequiredText: TextRef = ImplementationStrings.webdav_reauth_required
+
+    // ----- Configuration (the "sign in") -----
+
+    fun saveConfig(url: String, username: String, password: String) {
+        store.putString(WEBDAV_URL, url.trim())
+        store.putString(WEBDAV_USERNAME, username.trim())
+        store.putString(WEBDAV_PASSWORD, password)
+    }
+
+    fun savedUrlAndUsername(): Pair<String, String> =
+        store.getString(WEBDAV_URL, "") to store.getString(WEBDAV_USERNAME, "")
+
+    /** Everything the config dialog restores, password included, so it opens prefilled. */
+    fun savedConfig(): CloudDirectoryManager.WebDavSavedConfig =
+        CloudDirectoryManager.WebDavSavedConfig(
+            url = store.getString(WEBDAV_URL, ""),
+            username = store.getString(WEBDAV_USERNAME, ""),
+            password = store.getString(WEBDAV_PASSWORD, "")
+        )
+
+    private fun isConfigured(): Boolean =
+        store.getString(WEBDAV_URL, "").isNotBlank() &&
+            store.getString(WEBDAV_USERNAME, "").isNotBlank()
+
+    // ----- Signing in -----
+
+    /** No browser flow. The maintenance screen collects the address and credentials itself. */
+    override suspend fun startAuth(): String? = null
+
+    override suspend fun completeAuth(authCode: String): Boolean = false
+
+    override fun hasValidCredentials(): Boolean = isConfigured()
+
+    override fun clearCredentials() {
+        store.putString(WEBDAV_URL, "")
+        store.putString(WEBDAV_USERNAME, "")
+        store.putString(WEBDAV_PASSWORD, "")
+        store.putString(SELECTED_FOLDER, "")
+        clearConnectionError()
+    }
+
+    /** Nothing to revoke server-side beyond dropping the credentials. */
+    override suspend fun revokeAccess(): Boolean {
+        clearCredentials()
+        return true
+    }
+
+    /** WebDAV has no bearer token; credentials travel with every request. */
+    override suspend fun getValidAccessToken(): String? = null
+
+    // ----- Using it -----
+
+    override suspend fun testConnection(): Boolean = try {
+        val response = davRequest("PROPFIND", urlFor(""), depth = "0", bodyXml = PROPFIND_BODY)
+        if (response.status.value in OK_STATUS) {
+            clearConnectionError()
+            true
+        } else {
+            aapsLogger.error(
+                LTag.CORE, "$TAG the server answered ${response.status.value} for the connection test"
+            )
+            noteFailure()
+            false
+        }
+    } catch (e: Exception) {
+        aapsLogger.error(LTag.CORE, "$TAG could not reach the server: ${e.message}")
+        noteFailure()
+        false
+    }
+
+    override suspend fun getOrCreateFolderPath(path: String): String? = try {
+        val segments = path.split('/').filter { it.isNotBlank() }
+        var current = ""
+        for (segment in segments) {
+            current += "/$segment"
+            val response = davRequest("MKCOL", urlFor(current))
+            // 405 means the collection already exists, which is what we wanted anyway.
+            if (response.status.value !in MKCOL_OK) {
+                aapsLogger.error(
+                    LTag.CORE, "$TAG MKCOL $current answered ${response.status.value}"
+                )
+                noteFailure()
+                return null
+            }
+        }
+        current
+    } catch (e: Exception) {
+        aapsLogger.error(LTag.CORE, "$TAG could not create $path: ${e.message}")
+        noteFailure()
+        null
+    }
+
+    override suspend fun createFolder(name: String, parentId: String): String? {
+        val folderUrl = urlFor(parentId, name)
+        return try {
+            val response = davRequest("MKCOL", folderUrl)
+            if (response.status.value in MKCOL_OK) folderUrl else {
+                aapsLogger.error(
+                    LTag.CORE, "$TAG MKCOL $folderUrl answered ${response.status.value}"
+                )
+                noteFailure()
+                null
+            }
+        } catch (e: Exception) {
+            aapsLogger.error(LTag.CORE, "$TAG could not create folder $name: ${e.message}")
+            noteFailure()
+            null
+        }
+    }
+
+    override suspend fun listFolders(parentId: String): List<CloudFolder> = try {
+        val response = davRequest("PROPFIND", urlFor(parentId), depth = "1", bodyXml = PROPFIND_BODY)
+        if (response.status.value !in OK_STATUS) {
+            noteFailure()
+            emptyList()
+        } else {
+            val parentName = parentId.trimEnd('/').substringAfterLast('/')
+            parseMultistatus(response.bodyAsText())
+                .filter { it.isCollection }
+                .mapNotNull { entry ->
+                    val name = entry.href.trimEnd('/').substringAfterLast('/').decodeURLPart()
+                    if (name.isNotEmpty() && name != parentName) CloudFolder(id = entry.href, name = name) else null
+                }
+        }
+    } catch (e: Exception) {
+        aapsLogger.error(LTag.CORE, "$TAG could not list folders: ${e.message}")
+        noteFailure()
+        emptyList()
+    }
+
+    override suspend fun uploadFileToPath(
+        fileName: String,
+        content: ByteArray,
+        mimeType: String,
+        path: String
+    ): String? {
+        val folder = getOrCreateFolderPath(path) ?: return null
+        return uploadTo(folder, fileName, content, mimeType)
+    }
+
+    override suspend fun uploadFile(fileName: String, content: ByteArray, mimeType: String): String? =
+        uploadTo(getSelectedFolderId(), fileName, content, mimeType)
+
+    private suspend fun uploadTo(folder: String, fileName: String, content: ByteArray, mimeType: String): String? = try {
+        val response = davRequest("PUT", urlFor(folder, fileName), bodyBytes = content, contentType = mimeType)
+        if (response.status.value in PUT_OK) "$folder/$fileName" else {
+            aapsLogger.error(LTag.CORE, "$TAG PUT $fileName answered ${response.status.value}")
+            noteFailure()
+            null
+        }
+    } catch (e: Exception) {
+        aapsLogger.error(LTag.CORE, "$TAG could not upload $fileName: ${e.message}")
+        noteFailure()
+        null
+    }
+
+    override suspend fun downloadFile(fileId: String): ByteArray? = try {
+        val response = davRequest("GET", urlFor(fileId))
+        if (response.status.value in OK_STATUS) response.bodyAsBytes() else {
+            aapsLogger.error(LTag.CORE, "$TAG GET $fileId answered ${response.status.value}")
+            noteFailure()
+            null
+        }
+    } catch (e: Exception) {
+        aapsLogger.error(LTag.CORE, "$TAG could not download $fileId: ${e.message}")
+        noteFailure()
+        null
+    }
+
+    override suspend fun listSettingsFiles(pageSize: Int, pageToken: String?): CloudFileListResult = try {
+        val response = davRequest("PROPFIND", urlFor(getSelectedFolderId()), depth = "1", bodyXml = PROPFIND_BODY)
+        if (response.status.value !in OK_STATUS) {
+            noteFailure()
+            CloudFileListResult(files = emptyList())
+        } else {
+            val all = parseMultistatus(response.bodyAsText())
+                .filter { !it.isCollection }
+                .mapNotNull { entry ->
+                    val name = entry.href.trimEnd('/').substringAfterLast('/').decodeURLPart()
+                    if (name.endsWith(".json")) CloudFile(id = hrefToPath(entry.href), name = name, mimeType = SETTINGS_MIME) else null
+                }
+            val offset = pageToken?.toIntOrNull() ?: 0
+            val page = all.drop(offset).take(pageSize)
+            val next = if (offset + pageSize < all.size) (offset + pageSize).toString() else null
+            CloudFileListResult(files = page, nextPageToken = next)
+        }
+    } catch (e: Exception) {
+        aapsLogger.error(LTag.CORE, "$TAG could not list settings files: ${e.message}")
+        noteFailure()
+        CloudFileListResult(files = emptyList())
+    }
+
+    override suspend fun countSettingsFiles(): Int = try {
+        val response = davRequest("PROPFIND", urlFor(getSelectedFolderId()), depth = "1", bodyXml = PROPFIND_BODY)
+        if (response.status.value !in OK_STATUS) 0
+        else parseMultistatus(response.bodyAsText())
+            .count { !it.isCollection && it.href.trimEnd('/').substringAfterLast('/').decodeURLPart().endsWith(".json") }
+    } catch (e: Exception) {
+        0
+    }
+
+    override fun getSelectedFolderId(): String = store.getString(SELECTED_FOLDER, "")
+
+    override fun setSelectedFolderId(folderId: String) = store.putString(SELECTED_FOLDER, folderId)
+
+    // ----- Whether the last attempt worked -----
+
+    private var connectionError = false
+
+    override fun hasConnectionError(): Boolean = connectionError
+
+    override fun clearConnectionError() {
+        connectionError = false
+    }
+
+    /**
+     * A backup that has stopped working is the definition of a thing nobody notices, so like the
+     * Drive provider this raises one notification per hour of trouble, not one per attempt.
+     */
+    private fun noteFailure() {
+        aapsLogger.error(LTag.CORE, "$TAG the server could not be reached")
+        notificationManager.post(
+            id = NotificationId.WEBDAV_ERROR,
+            textRef = ImplementationStrings.webdav_connect_error,
+            validMinutes = ERROR_NOTIFICATION_MINUTES
+        )
+        connectionError = true
+    }
+
+    // ----- HTTP plumbing -----
+
+    private fun basicAuthValue(): String =
+        "Basic " + Base64.encode(
+            "${store.getString(WEBDAV_USERNAME, "")}:${store.getString(WEBDAV_PASSWORD, "")}".encodeToByteArray()
+        )
+
+    private suspend fun davRequest(
+        method: String,
+        url: String,
+        depth: String? = null,
+        bodyXml: String? = null,
+        bodyBytes: ByteArray? = null,
+        contentType: String? = null
+    ): HttpResponse = http.request(url) {
+        this.method = HttpMethod(method)
+        header(HttpHeaders.Authorization, basicAuthValue())
+        if (depth != null) header("Depth", depth)
+        if (contentType != null) header(HttpHeaders.ContentType, contentType)
+        when {
+            bodyBytes != null -> setBody(bodyBytes)
+            bodyXml != null -> setBody(bodyXml)
+        }
+    }
+
+    /** Server address with exactly one trailing slash, so paths can be appended blindly. */
+    private fun base(): String {
+        val raw = store.getString(WEBDAV_URL, "").trim()
+        return if (raw.endsWith("/")) raw else "$raw/"
+    }
+
+    /**
+     * Joins the base address and path segments into a URL. Segments arrive either raw
+     * (`/AAPS/export`) or already percent-encoded (a href from a PROPFIND answer), so each one is
+     * decoded before it is encoded - an encoded `%20` would otherwise become `%2520`.
+     */
+    private fun urlFor(vararg segments: String): String =
+        base() + segments.flatMap { it.split('/') }
+            .filter { it.isNotBlank() }
+            .joinToString("/") { it.decodeURLPart().encodeURLParameter() }
+
+    /** Turns an href (absolute URL or absolute path) into the path form used as a file ID. */
+    private fun hrefToPath(href: String): String {
+        val path = when {
+            href.startsWith("http://") || href.startsWith("https://") -> href.substringAfter("://").substringAfter('/')
+            else                                                     -> href
+        }
+        return "/" + path.trimStart('/')
+    }
+
+    private data class DavEntry(val href: String, val isCollection: Boolean)
+
+    private fun parseMultistatus(xml: String): List<DavEntry> {
+        val blockRegex = Regex(
+            "<(?:[A-Za-z0-9]+:)?response\\b.*?</(?:[A-Za-z0-9]+:)?response>",
+            setOf(RegexOption.DOT_MATCHES_ALL, RegexOption.IGNORE_CASE)
+        )
+        val hrefRegex = Regex(
+            "<(?:[A-Za-z0-9]+:)?href\\s*>(.*?)</(?:[A-Za-z0-9]+:)?href>",
+            setOf(RegexOption.DOT_MATCHES_ALL, RegexOption.IGNORE_CASE)
+        )
+        val collectionRegex = Regex("<(?:[A-Za-z0-9]+:)?collection\\b", RegexOption.IGNORE_CASE)
+        return blockRegex.findAll(xml).mapNotNull { match ->
+            val block = match.value
+            val href = hrefRegex.find(block)?.groupValues?.get(1) ?: return@mapNotNull null
+            DavEntry(href = unescapeXml(href).trim(), isCollection = collectionRegex.containsMatchIn(block))
+        }.toList()
+    }
+
+    private fun unescapeXml(value: String): String = value
+        .replace("&lt;", "<")
+        .replace("&gt;", ">")
+        .replace("&quot;", "\"")
+        .replace("&#39;", "'")
+        .replace("&amp;", "&")
+
+    companion object {
+
+        private const val TAG = "WebDavProvider:"
+
+        /** Stored credentials. Keys are provider-specific so they never collide with Drive's. */
+        const val WEBDAV_URL = "webdav_url"
+        const val WEBDAV_USERNAME = "webdav_username"
+        const val WEBDAV_PASSWORD = "webdav_password"
+
+        private const val SELECTED_FOLDER = "webdav_folder_path"
+        private const val SETTINGS_MIME = "application/json"
+        private const val ERROR_NOTIFICATION_MINUTES = 60
+
+        private val OK_STATUS = 200..299
+        private val PUT_OK = 200..299
+
+        /** 201 created, 200/204 fine, 405 already there, 301 redirected - all mean "try the next". */
+        private val MKCOL_OK = listOf(200, 201, 204, 301, 405)
+
+        /**
+         * The request body for a PROPFIND. Only `resourcetype` is asked for, because listing names
+         * and telling collections from files is all this provider ever needs.
+         */
+        internal const val PROPFIND_BODY =
+            "<?xml version=\"1.0\" encoding=\"utf-8\"?>" +
+                "<d:propfind xmlns:d=\"DAV:\"><d:prop><d:resourcetype/></d:prop></d:propfind>"
+    }
+}
+
+/**
+ * Builds the WebDAV provider for a platform, given that platform's HTTP engine.
+ *
+ * The caller supplies [http] and keeps ownership of it; nothing here closes it, because the
+ * provider lives as long as the app does.
+ */
+fun webDavProvider(
+    aapsLogger: AAPSLogger,
+    store: KeyValueStore,
+    notificationManager: NotificationManager,
+    http: HttpClient
+): WebDavProvider = WebDavProvider(
+    aapsLogger = aapsLogger,
+    store = store,
+    notificationManager = notificationManager,
+    http = http
+)
+
+/**
+ * A plain cloud icon for the provider row. Material's `Cloud` lives in the extended icon set,
+ * which this module does not pull in for one glyph - so the 24dp cloud path is spelled out here.
+ */
+val IcWebDav: ImageVector = ImageVector.Builder(
+    name = "IcWebDav",
+    defaultWidth = 24.dp,
+    defaultHeight = 24.dp,
+    viewportWidth = 24f,
+    viewportHeight = 24f
+).apply {
+    path(fill = SolidColor(Color(0xFF000000))) {
+        moveTo(19.35f, 10.04f)
+        curveTo(18.67f, 6.59f, 15.64f, 4f, 12f, 4f)
+        curveTo(9.11f, 4f, 6.6f, 5.64f, 5.35f, 8.04f)
+        curveTo(2.34f, 8.36f, 0f, 10.91f, 0f, 14f)
+        curveToRelative(0f, 3.31f, 2.69f, 6f, 6f, 6f)
+        horizontalLineToRelative(13f)
+        curveToRelative(2.76f, 0f, 5f, -2.24f, 5f, -5f)
+        curveTo(24f, 12.36f, 21.95f, 10.22f, 19.35f, 10.04f)
+        close()
+    }
+}.build()
